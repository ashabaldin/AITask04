Процедура Ошибка(Ошибки, Путь, Сообщение) Экспорт
	СчетаМагазинаЗначения.Ошибка(Ошибки, Путь, Сообщение);
КонецПроцедуры

Функция НайтиОбъекты(ТипОбъекта, СтрокаПоиска, Лимит) Экспорт
	Мета = ТипОбъекта.metadata;
	Если ТипОбъекта.kind = "catalog" Тогда
		ПолеПоиска = "Объекты.Наименование";
		Код = ?(Мета.ДлинаКода > 0, "Объекты.Код", """""");
		Группа = ?(СчетаМагазинаМетаданные.ЕстьГруппы(ТипОбъекта), "Объекты.ЭтоГруппа", "ЛОЖЬ");
		ОсобыеПоля = Код + " КАК Код, " + Группа + " КАК ЭтоГруппа";
	Иначе
		ПолеПоиска = "Объекты.Номер";
		Если СчетаМагазинаМетаданные.Реквизит(Мета, "Номер").Тип.СодержитТип(Тип("Число")) Тогда
			ПолеПоиска = "ВЫРАЗИТЬ(Объекты.Номер КАК СТРОКА(" + Формат(Мета.ДлинаНомера, "ЧГ=0") + "))";
		КонецЕсли;
		ОсобыеПоля = "Объекты.Номер КАК Номер, Объекты.Дата КАК Дата, Объекты.Проведен КАК Проведен";
	КонецЕсли;
	// В текст попадают только метаданные проверенного типа и проверенный числовой лимит.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + "
		| Объекты.Ссылка КАК Ссылка, ПРЕДСТАВЛЕНИЕ(Объекты.Ссылка) КАК Представление, " + ОсобыеПоля + "
		| ИЗ " + Мета.ПолноеИмя() + " КАК Объекты
		| ГДЕ НЕ Объекты.ПометкаУдаления
		| И " + ПолеПоиска + " ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		| УПОРЯДОЧИТЬ ПО Объекты." + ?(ТипОбъекта.kind = "catalog", "Наименование", "Номер") + ", Объекты.Ссылка";
	Шаблон = СокрЛП(СтрокаПоиска);
	Шаблон = СтрЗаменить(Шаблон, "~", "~~");
	Для Каждого Символ Из СтрРазделить("%,_,[,],^", ",") Цикл
		Шаблон = СтрЗаменить(Шаблон, Символ, "~" + Символ);
	КонецЦикла;
	Запрос.УстановитьПараметр("Шаблон", "%" + Шаблон + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() = Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Если ТипОбъекта.kind = "catalog" Тогда
			Элемент = КраткоИзПолей(ТипОбъекта, Выборка.Ссылка, Выборка.Представление, Выборка.Код, Выборка.ЭтоГруппа);
		Иначе
			Элемент = КраткоИзПолей(ТипОбъекта, Выборка.Ссылка, Выборка.Представление,,, Выборка.Номер, Выборка.Дата, Выборка.Проведен);
		КонецЕсли;
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Функция Прочитать(ТипОбъекта, Схема, Идентификатор, Ошибки) Экспорт
	Мета = ТипОбъекта.metadata;
	Менеджер = ?(ТипОбъекта.kind = "catalog", Справочники[Мета.Имя], Документы[Мета.Имя]);
	Ссылка = Менеджер.ПолучитьСсылку(Идентификатор);
	// Создание ссылки не доказывает существование. Запрос также применяет RLS.
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + Мета.ПолноеИмя() + " ГДЕ Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Контекст = ?(ТипОбъекта.kind = "document", "document", "item");
	Если СчетаМагазинаМетаданные.ЕстьГруппы(ТипОбъекта) И Объект.ЭтоГруппа Тогда
		Контекст = "folder";
	КонецЕсли;
	Шапка = Новый Соответствие;
	Для Каждого Поле Из Схема.fields Цикл
		Если Поле.appliesTo.Найти(Контекст) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МетаПоля = СчетаМагазинаМетаданные.Реквизит(Мета, Поле.name);
		Шапка.Вставить(Поле.name, СчетаМагазинаЗначения.ВJSON(Объект[Поле.name], Поле, МетаПоля.Тип, "header." + Поле.name, Ошибки));
	КонецЦикла;
	Таблицы = Новый Соответствие;
	Для Каждого Таблица Из Схема.tables Цикл
		Если Таблица.appliesTo.Найти(Контекст) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		МетаТаблицы = Мета.ТабличныеЧасти[Таблица.name];
		Для Каждого СтрокаОбъекта Из Объект[Таблица.name] Цикл
			СтрокаJSON = Новый Соответствие;
			Путь = "tables." + Таблица.name + "[" + Формат(Строки.Количество(), "ЧГ=0; ЧН=0") + "].";
			Для Каждого Поле Из Таблица.fields Цикл
				Если Поле.appliesTo.Найти(Контекст) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				МетаПоля = СчетаМагазинаМетаданные.Реквизит(МетаТаблицы, Поле.name);
				СтрокаJSON.Вставить(Поле.name, СчетаМагазинаЗначения.ВJSON(СтрокаОбъекта[Поле.name], Поле, МетаПоля.Тип, Путь + Поле.name, Ошибки));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Таблицы.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Кратко(ТипОбъекта, Объект);
	Результат.Вставить("header", Шапка);
	Результат.Вставить("tables", Таблицы);
	Возврат Результат;
КонецФункции

Функция Кратко(ТипОбъекта, Объект) Экспорт
	Если ТипОбъекта.kind = "catalog" Тогда
		Код = ?(ТипОбъекта.metadata.ДлинаКода > 0, Объект.Код, "");
		Группа = СчетаМагазинаМетаданные.ЕстьГруппы(ТипОбъекта) И Объект.ЭтоГруппа;
		Возврат КраткоИзПолей(ТипОбъекта, Объект.Ссылка, Строка(Объект.Ссылка), Код, Группа);
	КонецЕсли;
	Номер = ?(ТипОбъекта.metadata.ДлинаНомера > 0, Объект.Номер, "");
	Возврат КраткоИзПолей(ТипОбъекта, Объект.Ссылка, Строка(Объект.Ссылка),,, Номер, Объект.Дата, Объект.Проведен);
КонецФункции

Функция КраткоИзПолей(ТипОбъекта, Ссылка, Представление, Код = "", Группа = Ложь, Номер = "", ДатаОбъекта = Неопределено, Проведен = Ложь)
	Результат = Новый Структура("type,id,name", ТипОбъекта.name, НРег(Строка(Ссылка.УникальныйИдентификатор())), Представление);
	Если ТипОбъекта.kind = "catalog" Тогда
		Результат.Вставить("code", НомерСтрокой(Код));
		Результат.Вставить("isFolder", Группа);
	Иначе
		Результат.Вставить("number", НомерСтрокой(Номер));
		Результат.Вставить("date", ?(ЗначениеЗаполнено(ДатаОбъекта), Формат(ДатаОбъекта, "ДФ=yyyy-MM-ddTHH:mm:ss"), Неопределено));
		Результат.Вставить("posted", Проведен);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция НомерСтрокой(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧДЦ=0; ЧН=0");
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция Подготовить(Данные, ТипОбъекта, Схема, Ошибки) Экспорт
	Контекст = ?(ТипОбъекта.kind = "document", "document", "item");
	Шапка = ПодготовитьПоля(Данные.Получить("header"), Схема.fields, ТипОбъекта.metadata,
		Контекст, "header.", Истина, Ошибки);
	Таблицы = Новый Соответствие;
	Для Каждого Пара Из Данные.Получить("tables") Цикл
		Путь = "tables." + Пара.Ключ;
		Таблица = СчетаМагазинаМетаданные.НайтиОписание(Схема.tables, Пара.Ключ);
		Если Таблица = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестная табличная часть");
			Продолжить;
		КонецЕсли;
		Если Не Таблица.writable Или Таблица.appliesTo.Найти(Контекст) = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Табличная часть закрыта для записи");
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Пара.Значение) <> Тип("Массив") Тогда
			Ошибка(Ошибки, Путь, "Табличная часть должна быть массивом строк");
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Для Каждого СтрокаJSON Из Пара.Значение Цикл
			ПутьСтроки = Путь + "[" + Формат(Строки.Количество(), "ЧГ=0; ЧН=0") + "]";
			Если ТипЗнч(СтрокаJSON) <> Тип("Соответствие") Тогда
				Ошибка(Ошибки, ПутьСтроки, "Строка таблицы должна быть объектом JSON");
				Строки.Добавить(Неопределено);
				Продолжить;
			КонецЕсли;
			Строки.Добавить(ПодготовитьПоля(СтрокаJSON, Таблица.fields, ТипОбъекта.metadata.ТабличныеЧасти[Таблица.name],
				Контекст, ПутьСтроки + ".", Ложь, Ошибки));
		КонецЦикла;
		Таблицы.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Возврат Новый Структура("header,tables", Шапка, Таблицы);
КонецФункции

Функция ПодготовитьПоля(Вход, Поля, Мета, Контекст, ПрефиксПути, Шапка, Ошибки)
	Результат = Новый Соответствие;
	Для Каждого Пара Из Вход Цикл
		Путь = ПрефиксПути + Пара.Ключ;
		Поле = СчетаМагазинаМетаданные.НайтиОписание(Поля, Пара.Ключ);
		Если Поле = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестное поле");
			Продолжить;
		КонецЕсли;
		Если Не Поле.writable Или Поле.appliesTo.Найти(Контекст) = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Поле закрыто для записи");
			Продолжить;
		КонецЕсли;
		Роль = ?(Шапка И Поле.standard И Поле.name = "Родитель", "parent", "ordinary");
		МетаПоля = СчетаМагазинаМетаданные.Реквизит(Мета, Поле.name);
		Результат.Вставить(Поле.name, СчетаМагазинаЗначения.ИзJSON(Пара.Значение, Поле, МетаПоля.Тип, Роль, Путь, Ошибки));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Создать(ТипОбъекта) Экспорт
	Если ТипОбъекта.kind = "catalog" Тогда
		Возврат Справочники[ТипОбъекта.metadata.Имя].СоздатьЭлемент();
	КонецЕсли;
	Возврат Документы[ТипОбъекта.metadata.Имя].СоздатьДокумент();
КонецФункции

Функция ЗаписиРегистра(Регистр, Описание, Момент, Отбор, ЭтоСрез, Ошибки, ПериодКлюча = Неопределено) Экспорт
	Запрос = Новый Запрос;
	ЗначенияОтбора = Новый Массив;
	Запрос.Текст = ТекстЗапросаРегистра(Регистр, Отбор, ЭтоСрез, ПериодКлюча, ЗначенияОтбора);
	Если ЭтоСрез Тогда
		Запрос.УстановитьПараметр("Дата", Момент);
	КонецЕсли;
	Если ПериодКлюча <> Неопределено Тогда
		Запрос.УстановитьПараметр("Период", ПериодКлюча);
	КонецЕсли;
	Для Номер = 0 По ЗначенияОтбора.ВГраница() Цикл
		Запрос.УстановитьПараметр("Отбор" + Формат(Номер + 1, "ЧГ=0"), ЗначенияОтбора[Номер]);
	КонецЦикла;
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() = 100 Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Путь = "items[" + Формат(Элементы.Количество(), "ЧГ=0") + "].";
		Элемент = Новый Структура("period,dimensions,resources,attributes",
			Формат(Выборка.Период, "ДФ=yyyy-MM-ddTHH:mm:ss"),
			ПоляРегистраВJSON(Выборка, Описание.dimensions, Регистр.metadata.Измерения, Путь + "dimensions.", Ошибки),
			ПоляРегистраВJSON(Выборка, Описание.resources, Регистр.metadata.Ресурсы, Путь + "resources.", Ошибки),
			ПоляРегистраВJSON(Выборка, Описание.attributes, Регистр.metadata.Реквизиты, Путь + "attributes.", Ошибки));
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Функция ТекстЗапросаРегистра(Регистр, Отбор, ЭтоСрез, ПериодКлюча, ЗначенияОтбора)
	Мета = Регистр.metadata;
	Поля = Новый Массив;
	Поля.Добавить("Записи.Период КАК Период");
	Порядок = Новый Массив;
	Если Не ЭтоСрез Тогда
		Порядок.Добавить("Записи.Период УБЫВ");
	КонецЕсли;
	Условия = Новый Массив;
	// История фильтрует измерения без периода: индекс регистра начинается с периода, таблицы демо небольшие.
	// Повторное чтение после записи ставит период первым условием и попадает в этот индекс.
	Если Не ЭтоСрез И ПериодКлюча <> Неопределено Тогда
		Условия.Добавить("Записи.Период = &Период");
	КонецЕсли;
	ДобавитьПоляРегистра(Поля, Порядок, Условия, ЗначенияОтбора, Мета.Измерения, Отбор, ЭтоСрез);
	Если Порядок.Количество() = 0 Тогда
		Порядок.Добавить("Записи.Период");
	КонецЕсли;
	Для Каждого МетаПоля Из Мета.Ресурсы Цикл
		Поля.Добавить("Записи." + МетаПоля.Имя + " КАК " + МетаПоля.Имя);
	КонецЦикла;
	Для Каждого МетаПоля Из Мета.Реквизиты Цикл
		Поля.Добавить("Записи." + МетаПоля.Имя + " КАК " + МетаПоля.Имя);
	КонецЦикла;
	Если ЭтоСрез Тогда
		ОтборТаблицы = "";
		Если Условия.Количество() > 0 Тогда
			ОтборТаблицы = ", " + СтрСоединить(Условия, " И ");
		КонецЕсли;
		Источник = Мета.ПолноеИмя() + ".СрезПоследних(&Дата" + ОтборТаблицы + ")";
	Иначе
		Источник = Мета.ПолноеИмя();
	КонецЕсли;
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 101
		| " + СтрСоединить(Поля, ", ") + "
		| ИЗ " + Источник + " КАК Записи";
	Если Не ЭтоСрез И Условия.Количество() > 0 Тогда
		Текст = Текст + "
			| ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;
	Текст = Текст + "
		| УПОРЯДОЧИТЬ ПО " + СтрСоединить(Порядок, ", ");
	Возврат Текст;
КонецФункции

Процедура ДобавитьПоляРегистра(Поля, Порядок, Условия, ЗначенияОтбора, КоллекцияПолей, Отбор, ЭтоСрез)
	Для Каждого МетаПоля Из КоллекцияПолей Цикл
		Поля.Добавить("Записи." + МетаПоля.Имя + " КАК " + МетаПоля.Имя);
		Порядок.Добавить("Записи." + МетаПоля.Имя);
		Если Не ЕстьКлючОтбора(Отбор, МетаПоля.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЗначенияОтбора.Добавить(Отбор.Получить(МетаПоля.Имя));
		ИмяПоля = ?(ЭтоСрез, МетаПоля.Имя, "Записи." + МетаПоля.Имя);
		Условия.Добавить(ИмяПоля + " = &Отбор" + Формат(ЗначенияОтбора.Количество(), "ЧГ=0"));
	КонецЦикла;
КонецПроцедуры

Функция ЕстьКлючОтбора(Отбор, Имя)
	Для Каждого Пара Из Отбор Цикл
		Если Пара.Ключ = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПоляРегистраВJSON(Выборка, Поля, МетаПоля, Префикс, Ошибки)
	Результат = Новый Соответствие;
	Для Каждого Поле Из Поля Цикл
		Результат.Вставить(Поле.name, СчетаМагазинаЗначения.ВJSON(Выборка[Поле.name], Поле, МетаПоля[Поле.name].Тип, Префикс + Поле.name, Ошибки));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПодготовитьЗаписьРегистра(Данные, Регистр, Описание, Ошибки) Экспорт
	Результат = Новый Структура("period,dimensions,resources", Неопределено, Новый Соответствие, Новый Соответствие);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, Неопределено, "Корень должен быть объектом JSON");
		Возврат Результат;
	КонецЕсли;
	Допустимые = СтрРазделить("name,period,dimensions,resources", ",");
	Для Каждого Пара Из Данные Цикл
		Если Допустимые.Найти(Пара.Ключ) = Неопределено Тогда
			Ошибка(Ошибки, Пара.Ключ, "Неизвестное поле корня");
		КонецЕсли;
	КонецЦикла;
	Если Не СчетаМагазинаЗначения.ЕстьКлюч(Данные, "name") Или ТипЗнч(Данные.Получить("name")) <> Тип("Строка") Тогда
		Ошибка(Ошибки, "name", "Отсутствует обязательное поле или неверный тип JSON");
	КонецЕсли;
	Если Не СчетаМагазинаЗначения.ЕстьКлюч(Данные, "period") Или ТипЗнч(Данные.Получить("period")) <> Тип("Строка") Тогда
		Ошибка(Ошибки, "period", "Отсутствует обязательное поле или неверный тип JSON");
	Иначе
		Период = СчетаМагазинаЗначения.НачалоПериода(Данные.Получить("period"), Регистр.periodicity);
		Если Период = Неопределено Тогда
			Ошибка(Ошибки, "period", "Неверная дата периода: требуется YYYY-MM-DD или YYYY-MM-DDTHH:mm:ss");
		Иначе
			Результат.period = Период;
		КонецЕсли;
	КонецЕсли;
	Результат.dimensions = ПодготовитьРазделРегистра(Данные, "dimensions", Описание.dimensions, Регистр.metadata.Измерения, Истина, Ошибки);
	Результат.resources = ПодготовитьРазделРегистра(Данные, "resources", Описание.resources, Регистр.metadata.Ресурсы, Ложь, Ошибки);
	Возврат Результат;
КонецФункции

Функция ПодготовитьРазделРегистра(Данные, ИмяРаздела, Поля, МетаКоллекция, ПроверятьПустоеИзмерение, Ошибки)
	Результат = Новый Соответствие;
	Если Не СчетаМагазинаЗначения.ЕстьКлюч(Данные, ИмяРаздела) Или ТипЗнч(Данные.Получить(ИмяРаздела)) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, ИмяРаздела, "Отсутствует обязательное поле или неверный тип JSON");
		Возврат Результат;
	КонецЕсли;
	Вход = Данные.Получить(ИмяРаздела);
	Для Каждого Пара Из Вход Цикл
		Путь = ИмяРаздела + "." + Пара.Ключ;
		Поле = СчетаМагазинаМетаданные.НайтиОписание(Поля, Пара.Ключ);
		Если Поле = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестное поле");
			Продолжить;
		КонецЕсли;
		Если Не Поле.writable Тогда
			Ошибка(Ошибки, Путь, "Поле закрыто для записи");
			Продолжить;
		КонецЕсли;
		БылоОшибок = Ошибки.Количество();
		Значение = СчетаМагазинаЗначения.ИзJSON(Пара.Значение, Поле, МетаКоллекция[Поле.name].Тип, "ordinary", Путь, Ошибки);
		Если ПроверятьПустоеИзмерение И Ошибки.Количество() = БылоОшибок И Поле.required И Не ЗначениеЗаполнено(Значение) Тогда
			Ошибка(Ошибки, Путь, "Пустое обязательное измерение");
		КонецЕсли;
		Результат.Вставить(Поле.name, Значение);
	КонецЦикла;
	Для Каждого Поле Из Поля Цикл
		Если Не СчетаМагазинаЗначения.ЕстьКлюч(Вход, Поле.name) Тогда
			Ошибка(Ошибки, ИмяРаздела + "." + Поле.name, "Отсутствует обязательное поле");
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НаборЗаписиРегистра(Регистр, Подготовленные) Экспорт
	Набор = РегистрыСведений[Регистр.metadata.Имя].СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Подготовленные.period);
	Для Каждого Пара Из Подготовленные.dimensions Цикл
		Набор.Отбор[Пара.Ключ].Установить(Пара.Значение);
	КонецЦикла;
	Набор.Прочитать();
	Заменен = Набор.Количество() > 0;
	Если Заменен Тогда
		Для Каждого Запись Из Набор Цикл
			Для Каждого Пара Из Подготовленные.resources Цикл
				Запись[Пара.Ключ] = Пара.Значение;
			КонецЦикла;
		КонецЦикла;
	Иначе
		Запись = Набор.Добавить();
		Запись.Период = Подготовленные.period;
		Для Каждого Пара Из Подготовленные.dimensions Цикл
			Запись[Пара.Ключ] = Пара.Значение;
		КонецЦикла;
		Для Каждого Пара Из Подготовленные.resources Цикл
			Запись[Пара.Ключ] = Пара.Значение;
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("set,replaced", Набор, Заменен);
КонецФункции

Процедура Заполнить(Объект, Данные) Экспорт
	Для Каждого Пара Из Данные.header Цикл
		Объект[Пара.Ключ] = Пара.Значение;
	КонецЦикла;
	Для Каждого Пара Из Данные.tables Цикл
		Таблица = Объект[Пара.Ключ];
		Таблица.Очистить();
		Для Каждого СтрокаДанных Из Пара.Значение Цикл
			СтрокаОбъекта = Таблица.Добавить();
			Для Каждого Поле Из СтрокаДанных Цикл
				СтрокаОбъекта[Поле.Ключ] = Поле.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
